# Copy to .env and fill. Never commit .env itself.
# Supabase — Dashboard → Project Settings → API
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # server only, never VITE_ prefix
SUPABASE_JWKS_KEY=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# Vite (public, baked into bundle)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=<project>

# Email — Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_...
RESEND_FROM="Cabinet Dr. Wajih <onboarding@resend.dev>"  # use onboarding until noreply@drwajihbensoltana.tn verified
# TESTING: all clinic notifications go to CLINIC_EMAIL — keep dr.bensoltanawajih@gmail.com out until launch
CLINIC_EMAIL=rayen08yako@gmail.com
RESEND_REPLY_TO=rayen08yako@gmail.com
# PRODUCTION: switch to dr.bensoltanawajih@gmail.com when ready to go live
# CLINIC_EMAIL=dr.bensoltanawajih@gmail.com
# RESEND_REPLY_TO=dr.bensoltanawajih@gmail.com

# Admin bootstrap (one-time)
ADMIN_EMAIL=rayen08yako@gmail.com

# WhatsApp primary number (wa.me without + or spaces)
WHATSAPP_NUMBER=21655740439

# Optional
# TURNSTILE_SECRET_KEY=...
# VITE_TURNSTILE_SITE_KEY=...
